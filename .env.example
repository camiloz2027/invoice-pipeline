# Copy this file to .env and fill in the values. .env is NEVER committed to Git.

# API key for the AI extraction stage. Not needed for the other stages.
ANTHROPIC_API_KEY=

# Folder for all local data (invoices, images, database, logs).
# A relative path is resolved from the project root.
DATA_DIR=data

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
